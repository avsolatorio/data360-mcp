  "layer": [
    {
      "transform": [
        {
          "pivot": "comp_breakdown_1",
          "value": "value",
          "groupby": [
            "year",
            "TIME_PERIOD",
            "country"
          ]
        },
        {
          "calculate": "datum.est - 1.645 * datum.se",
          "as": "lower"
        },
        {
          "calculate": "datum.est + 1.645 * datum.se",
          "as": "upper"
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.2,
        "color": "#34A7F2"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "timeUnit": "utcyear",
          "axis": {
            "title": null,
            "format": "%Y",
            "tickCount": 5,
            "labelAngle": 0,
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold"
          }
        },
        "y": {
          "field": "lower",
          "type": "quantitative",
          "scale": {
            "zero": false
          }
        },
        "y2": {
          "field": "upper"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.comp_breakdown_1 == 'est'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "strokeCap": "round",
        "point": {
          "filled": true,
          "size": 56
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "timeUnit": "utcyear",
          "axis": {
            "title": null,
            "format": "%Y",
            "tickCount": 5,
            "labelAngle": 0,
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold"
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold",
            "tickCount": 5,
            "title": null,
            "labelExpr": "abs(datum.value)>=1e12 ? ''+format(datum.value/1e12,'.1f')+'t' : abs(datum.value)>=1e9 ? ''+format(datum.value/1e9,'.1f')+'b' : abs(datum.value)>=1e6 ? ''+format(datum.value/1e6,'.1f')+'m' : abs(datum.value)>=1e3 ? ''+format(datum.value/1e3,'.1f')+'k' : abs(datum.value)>=10 ? ''+format(datum.value,',.1f') : abs(datum.value)>=1 ? ''+format(datum.value,'.1f') : ''+format(datum.value,'.2f')"
          },
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "type": "temporal",
            "timeUnit": "utcyear",
            "format": "%Y"
          },
          {
            "field": "value",
            "title": "Value",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "country",
            "title": "Economy",
            "type": "nominal"
          },
          {
