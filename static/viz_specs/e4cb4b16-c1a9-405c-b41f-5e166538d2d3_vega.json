  "layer": [
    {
      "transform": [
        {
          "pivot": "comp_breakdown_1",
          "value": "value",
          "groupby": [
            "year",
            "country"
          ]
        },
        {
          "calculate": "datum.est - 1.645 * datum.se",
          "as": "lower"
        },
        {
          "calculate": "datum.est + 1.645 * datum.se",
          "as": "upper"
        }
      ],
      "mark": {
        "type": "area",
        "opacity": 0.2,
        "color": "#34A7F2"
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "grid": false,
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold",
            "tickCount": 5,
            "title": "Worldwide Governance Indicators: Voice and Accountability",
            "labelExpr": "abs(datum.value)>=1e12 ? ''+format(datum.value/1e12,'.1~f')+'t' : abs(datum.value)>=1e9 ? ''+format(datum.value/1e9,'.1~f')+'b' : abs(datum.value)>=1e6 ? ''+format(datum.value/1e6,'.1~f')+'m' : abs(datum.value)>=1e3 ? ''+format(datum.value/1e3,'.1~f')+'k' : abs(datum.value)>=10 ? ''+format(datum.value,',.1~f') : abs(datum.value)>=1 ? ''+format(datum.value,'.1~f') : ''+format(datum.value,'.2~f')"
          },
          "scale": {
            "zero": true
          }
        },
        "y": {
          "field": "lower",
          "type": "quantitative",
          "scale": {
            "zero": false
          }
        },
        "y2": {
          "field": "upper"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.comp_breakdown_1 == 'est'"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 3,
        "cornerRadiusBottomRight": 3
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
