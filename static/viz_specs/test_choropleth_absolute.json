{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GDP Count Map",
    "subtitle": [
      "Note: Map displays data for the most recent year (2020)",
      "WARNING: Choropleth maps should only be used to plot normalized data, not absolute numbers."
    ]
  },
  "width": 800,
  "height": 450,
  "data": {
    "name": "countries_with_data",
    "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },
  "transform": [
    {
      "filter": "indexof(['France', 'Germany', 'Italy', 'Spain', 'United States'], datum.properties.name) >= 0"
    }
  ],
  "projection": {
    "type": "equalEarth",
    "fit": "countries_with_data"
  },
  "layer": [
    {
      "data": {
        "url": "https://unpkg.com/world-atlas@2.0.2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eee",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "values": [
                {
                  "country": "France",
                  "year": "2020",
                  "value": 1600.0,
                  "_year_num": 2020
                },
                {
                  "country": "Germany",
                  "year": "2020",
                  "value": 1700.0,
                  "_year_num": 2020
                },
                {
                  "country": "Italy",
                  "year": "2020",
                  "value": 1500.0,
                  "_year_num": 2020
                },
                {
                  "country": "Spain",
                  "year": "2020",
                  "value": 1200.0,
                  "_year_num": 2020
                },
                {
                  "country": "United States",
                  "year": "2020",
                  "value": 3000.0,
                  "_year_num": 2020
                }
              ]
            },
            "key": "country",
            "fields": [
              "country",
              "year",
              "value",
              "_year_num"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "type": "quantize",
            "range": [
              "#eff3ff",
              "#bdd7e7",
              "#6baed6",
              "#3182bd",
              "#08519c"
            ]
          },
          "legend": {
            "title": "Value",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "type": "nominal"
          },
          {
            "field": "value",
            "title": "Value",
            "type": "quantitative",
            "format": "$,.2f"
          },
          {
            "field": "country",
            "title": "Economy",
            "type": "nominal"
          },
          {
            "field": "_year_num",
            "title": " Year Num"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Noto Sans, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#111111",
      "lineHeight": 22,
      "anchor": "start",
      "offset": 8,
      "subtitleFontSize": 12,
      "subtitleColor": "#666666",
      "subtitleFontWeight": "normal",
      "subtitlePadding": 4,
      "subtitleLineHeight": 18
    },
    "axis": {
      "labelColor": "#666666",
      "labelFontSize": 12,
      "labelFont": "Noto Sans, Arial, sans-serif",
      "titleColor": "#111111",
      "titleFontSize": 12,
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontWeight": "bold",
      "gridColor": "#CED4DE",
      "gridDash": [
        4,
        2
      ],
      "gridWidth": 1,
      "domainColor": "#CED4DE",
      "tickColor": "#CED4DE",
      "tickCount": 5,
      "labelOverlap": "greedy"
    },
    "legend": {
      "labelColor": "#111111",
      "labelFont": "Noto Sans, Arial, sans-serif",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelLimit": 300,
      "titleColor": "#111111",
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontSize": 12,
      "orient": "top",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#34A7F2",
        "#FF9800",
        "#664AB6",
        "#4EC2C0",
        "#F3578E",
        "#081079",
        "#0C7C68",
        "#AA0000",
        "#DDDA21"
      ]
    },
    "view": {
      "stroke": "transparent"
    },
    "line": {
      "strokeWidth": 3,
      "strokeCap": "round"
    },
    "point": {
      "size": 60,
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
}