{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Access to electricity, rural vs. Access to electricity, urban"
    ],
    "subtitle": [
      "Bangladesh, 2020"
    ]
  },
  "data": {
    "values": [
      {
        "year": "2020",
        "country": "Bangladesh",
        "indicator": "Rural",
        "value": 95.2
      },
      {
        "year": "2020",
        "country": "Bangladesh",
        "indicator": "Urban",
        "value": 97.8
      }
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 2,
    "cornerRadiusTopLeft": 2,
    "size": 40
  },
  "encoding": {
    "x": {
      "field": "indicator",
      "type": "nominal",
      "axis": {
        "title": null,
        "tickCount": 5,
        "labelAngle": -45,
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold",
        "labelAlign": "right",
        "labelBaseline": "middle",
        "labelLimit": 150,
        "labelOverlap": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold",
        "tickCount": 5,
        "title": "Percentage",
        "labelExpr": "format(datum.value, '.1~f') + '%'"
      },
      "scale": {
        "zero": true,
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "indicator",
      "type": "nominal",
      "scale": {
        "range": [
          "#34A7F2",
          "#FF9800",
          "#664AB6",
          "#4EC2C0",
          "#F3578E",
          "#081079",
          "#0C7C68",
          "#AA0000",
          "#DDDA21"
        ],
        "domain": [
          "Rural",
          "Urban"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "type": "nominal"
      },
      {
        "field": "value",
        "title": "Value",
        "type": "quantitative",
        "format": ",.1f"
      },
      {
        "field": "country",
        "title": "Economy",
        "type": "nominal"
      },
      {
        "field": "indicator",
        "title": "Indicator"
      }
    ]
  },
  "width": 600,
  "height": 350,
  "config": {
    "background": "#FFFFFF",
    "font": "Noto Sans, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#111111",
      "lineHeight": 22,
      "anchor": "start",
      "offset": 8,
      "subtitleFontSize": 12,
      "subtitleColor": "#666666",
      "subtitleFontWeight": "normal",
      "subtitlePadding": 4,
      "subtitleLineHeight": 18
    },
    "axis": {
      "grid": false,
      "labelColor": "#666666",
      "labelFontSize": 12,
      "labelFont": "Noto Sans, Arial, sans-serif",
      "titleColor": "#111111",
      "titleFontSize": 12,
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontWeight": "bold",
      "gridColor": "#CED4DE",
      "gridDash": [
        4,
        2
      ],
      "gridWidth": 1,
      "domainColor": "#CED4DE",
      "tickColor": "#CED4DE",
      "tickCount": 5,
      "labelOverlap": "greedy"
    },
    "legend": {
      "labelColor": "#111111",
      "labelFont": "Noto Sans, Arial, sans-serif",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelLimit": 300,
      "titleColor": "#111111",
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontSize": 12,
      "orient": "top",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#34A7F2",
        "#FF9800",
        "#664AB6",
        "#4EC2C0",
        "#F3578E",
        "#081079",
        "#0C7C68",
        "#AA0000",
        "#DDDA21"
      ]
    },
    "view": {
      "stroke": "transparent"
    },
    "line": {
      "strokeWidth": 3,
      "strokeCap": "round"
    },
    "point": {
      "size": 60,
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
}