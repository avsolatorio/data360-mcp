        4,
        2
      ],
      "gridWidth": 1,
      "domainColor": "#CED4DE",
      "tickColor": "#CED4DE",
      "tickCount": 5,
      "labelOverlap": "greedy"
    },
    "legend": {
      "labelColor": "#111111",
      "labelFont": "Noto Sans, Arial, sans-serif",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelLimit": 300,
      "titleColor": "#111111",
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontSize": 12,
      "orient": "top",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#34A7F2",
        "#FF9800",
        "#664AB6",
        "#4EC2C0",
        "#F3578E",
        "#081079",
        "#0C7C68",
        "#AA0000",
        "#DDDA21"
      ]
    },
    "view": {
      "stroke": "transparent"
    },
    "line": {
      "strokeWidth": 3,
      "strokeCap": "round"
    },
    "point": {
      "size": 60,
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
