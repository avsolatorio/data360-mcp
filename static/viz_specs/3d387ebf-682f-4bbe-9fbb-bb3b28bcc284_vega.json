  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 2,
    "cornerRadiusTopLeft": 2,
    "size": 40
  },
  "encoding": {
    "x": {
      "field": "indicator",
      "type": "nominal",
      "axis": {
        "title": null,
        "tickCount": 5,
        "labelAngle": -45,
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold",
        "labelAlign": "right",
        "labelBaseline": "middle",
        "labelLimit": 150,
        "labelOverlap": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold",
        "tickCount": 5,
        "title": null,
        "labelExpr": "format(datum.value, '.0%')"
      },
      "scale": {
        "zero": true,
        "domain": [
          0,
          1
        ]
      }
    },
    "color": {
      "field": "_combo_label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Brazil | Total",
          "Brazil | Paid",
          "Brazil | Formal",
          "Colombia | Total",
          "Colombia | Paid",
          "Colombia | Formal",
          "Mexico | Total",
          "Mexico | Paid",
          "Mexico | Formal"
        ],
        "range": [
          "#085486",
          "#169af0",
          "#87cbf7",
          "#875307",
          "#f29814",
          "#f8ca85",
          "#382965",
          "#6a4eb7",
          "#b2a4da"
        ]
      },
      "legend": {
        "labelFontSize": 11,
        "symbolSize": 80,
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 3,
        "labelLimit": 150,
        "title": "Country | Indicator"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "type": "nominal"
      },
      {
        "field": "value",
        "title": "Value",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "country",
        "title": "Economy",
        "type": "nominal"
      },
      {
        "field": "indicator",
        "title": "Indicator"
      }
    ],
    "xOffset": {
      "field": "country",
      "type": "nominal"
    }
  },
  "width": 600,
  "height": 350,
  "transform": [
    {
      "calculate": "datum['country'] + ' | ' + datum['indicator']",
      "as": "_combo_label"
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Noto Sans, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#111111",
      "lineHeight": 22,
      "anchor": "start",
      "offset": 8,
      "subtitleFontSize": 12,
      "subtitleColor": "#666666",
      "subtitleFontWeight": "normal",
      "subtitlePadding": 4,
      "subtitleLineHeight": 18
    },
    "axis": {
      "grid": false,
      "labelColor": "#666666",
      "labelFontSize": 12,
      "labelFont": "Noto Sans, Arial, sans-serif",
      "titleColor": "#111111",
      "titleFontSize": 12,
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontWeight": "bold",
      "gridColor": "#CED4DE",
