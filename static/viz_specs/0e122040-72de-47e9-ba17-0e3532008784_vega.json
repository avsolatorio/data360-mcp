{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "GDP per capita"
    ],
    "subtitle": [
      "Kenya, United States, 2020-2022",
      "US dollars, 2015 constant prices"
    ]
  },
  "data": {
    "values": [
      {
        "year": "2020",
        "value": 59533.609024,
        "country": "United States"
      },
      {
        "year": "2022",
        "value": 64322.233282,
        "country": "United States"
      },
      {
        "year": "2020",
        "value": 1609.334141,
        "country": "Kenya"
      },
      {
        "year": "2022",
        "value": 1747.531988,
        "country": "Kenya"
      },
      {
        "year": "2021",
        "value": 1698.895783,
        "country": "Kenya"
      },
      {
        "year": "2021",
        "value": 63096.785615,
        "country": "United States"
      }
    ]
  },
  "width": 600,
  "height": 350,
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "strokeCap": "round",
        "point": {
          "filled": true,
          "size": 56
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "temporal",
          "timeUnit": "utcyear",
          "axis": {
            "title": null,
            "format": "%Y",
            "tickCount": 5,
            "labelAngle": 0,
            "grid": false,
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold"
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "grid": false,
            "gridColor": "#CED4DE",
            "gridDash": [
              4,
              2
            ],
            "labelColor": "#666666",
            "titleColor": "#111111",
            "titleFontWeight": "bold",
            "tickCount": 5,
            "title": "US dollars, 2015 constant prices",
            "labelExpr": "abs(datum.value)>=1e12 ? '$'+format(datum.value/1e12,'.1~f')+'t' : abs(datum.value)>=1e9 ? '$'+format(datum.value/1e9,'.1~f')+'b' : abs(datum.value)>=1e6 ? '$'+format(datum.value/1e6,'.1~f')+'m' : abs(datum.value)>=1e3 ? '$'+format(datum.value/1e3,'.1~f')+'k' : abs(datum.value)>=10 ? '$'+format(datum.value,',.1~f') : abs(datum.value)>=1 ? '$'+format(datum.value,'.1~f') : '$'+format(datum.value,'.2~f')"
          },
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "type": "temporal",
            "timeUnit": "utcyear",
            "format": "%Y"
          },
          {
            "field": "value",
            "title": "Value",
            "type": "quantitative",
            "format": "$,.2f"
          },
          {
            "field": "country",
            "title": "Economy",
            "type": "nominal"
          },
          {
            "value": "GDP per capita",
            "title": "Indicator"
          }
        ],
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "range": [
              "#34A7F2",
              "#FF9800",
              "#664AB6",
              "#4EC2C0",
              "#F3578E",
              "#081079",
              "#0C7C68",
              "#AA0000",
              "#DDDA21"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "argmax",
              "field": "year",
              "as": "_last"
            }
          ],
          "groupby": [
            "country"
          ]
        },
        {
          "calculate": "datum._last.value",
          "as": "_end_value"
        },
        {
          "calculate": "datum._last.year",
          "as": "_end_year"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 10,
        "fontWeight": "normal",
        "tooltip": false
      },
      "encoding": {
        "x": {
          "field": "_end_year",
          "type": "ordinal"
        },
        "y": {
          "field": "_end_value",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "range": [
              "#34A7F2",
              "#FF9800",
              "#664AB6",
              "#4EC2C0",
              "#F3578E",
              "#081079",
              "#0C7C68",
              "#AA0000",
              "#DDDA21"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "font": "Noto Sans, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#111111",
      "lineHeight": 22,
      "anchor": "start",
      "offset": 8,
      "subtitleFontSize": 12,
      "subtitleColor": "#666666",
      "subtitleFontWeight": "normal",
      "subtitlePadding": 4,
      "subtitleLineHeight": 18
    },
    "axis": {
      "grid": false,
      "labelColor": "#666666",
      "labelFontSize": 12,
      "labelFont": "Noto Sans, Arial, sans-serif",
      "titleColor": "#111111",
      "titleFontSize": 12,
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontWeight": "bold",
      "gridColor": "#CED4DE",
      "gridDash": [
        4,
        2
      ],
      "gridWidth": 1,
      "domainColor": "#CED4DE",
      "tickColor": "#CED4DE",
      "tickCount": 5,
      "labelOverlap": "greedy"
    },
    "legend": {
      "labelColor": "#111111",
      "labelFont": "Noto Sans, Arial, sans-serif",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelLimit": 300,
      "titleColor": "#111111",
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontSize": 12,
      "orient": "top",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#34A7F2",
        "#FF9800",
        "#664AB6",
        "#4EC2C0",
        "#F3578E",
        "#081079",
        "#0C7C68",
        "#AA0000",
        "#DDDA21"
      ]
    },
    "view": {
      "stroke": "transparent"
    },
    "line": {
      "strokeWidth": 3,
      "strokeCap": "round"
    },
    "point": {
      "size": 60,
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
}