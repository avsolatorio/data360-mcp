{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Population ages 0-14, total | Population ages 15-64, total | Population ages 65",
      "and above, total"
    ],
    "subtitle": [
      "Spain, 2022",
      "Persons"
    ]
  },
  "data": {
    "values": [
      {
        "year": "2022",
        "country": "Spain",
        "indicator_name_melted": "0-14",
        "indicator_value_melted": 6496956.0
      },
      {
        "year": "2022",
        "country": "Spain",
        "indicator_name_melted": "15-64",
        "indicator_value_melted": 31642089.0
      },
      {
        "year": "2022",
        "country": "Spain",
        "indicator_name_melted": "65 And Above",
        "indicator_value_melted": 9647058.0
      }
    ],
    "format": {
      "parse": {
        "year": "string"
      }
    }
  },
  "width": 680,
  "height": 350,
  "mark": {
    "type": "line",
    "strokeWidth": 3,
    "strokeCap": "round",
    "point": {
      "filled": true,
      "size": 56
    },
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "timeUnit": "utcyear",
      "axis": {
        "title": null,
        "format": "%Y",
        "tickCount": 5,
        "labelAngle": 0,
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold"
      }
    },
    "y": {
      "field": "indicator_value_melted",
      "type": "quantitative",
      "axis": {
        "grid": false,
        "gridColor": "#CED4DE",
        "gridDash": [
          4,
          2
        ],
        "labelColor": "#666666",
        "titleColor": "#111111",
        "titleFontWeight": "bold",
        "tickCount": 5,
        "title": "Persons",
        "labelExpr": "abs(datum.value)>=1e12 ? ''+format(datum.value/1e12,'.1f')+'t' : abs(datum.value)>=1e9 ? ''+format(datum.value/1e9,'.1f')+'b' : abs(datum.value)>=1e6 ? ''+format(datum.value/1e6,'.1f')+'m' : abs(datum.value)>=1e3 ? ''+format(datum.value/1e3,'.1f')+'k' : abs(datum.value)>=10 ? ''+format(datum.value,',.1f') : abs(datum.value)>=1 ? ''+format(datum.value,'.1f') : ''+format(datum.value,'.2f')"
      },
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "indicator_name_melted",
      "type": "nominal",
      "scale": {
        "range": [
          "#34A7F2",
          "#FF9800",
          "#664AB6"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "type": "nominal"
      },
      {
        "field": "country",
        "title": "Economy",
        "type": "nominal"
      },
      {
        "field": "indicator_name_melted",
        "title": "Indicator",
        "type": "nominal"
      },
      {
        "field": "indicator_value_melted",
        "title": "Value",
        "type": "quantitative",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "background": "#FFFFFF",
    "font": "Noto Sans, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#111111",
      "lineHeight": 22,
      "anchor": "start",
      "offset": 8,
      "subtitleFontSize": 12,
      "subtitleColor": "#666666",
      "subtitleFontWeight": "normal",
      "subtitlePadding": 4,
      "subtitleLineHeight": 18
    },
    "axis": {
      "grid": false,
      "labelColor": "#666666",
      "labelFontSize": 12,
      "labelFont": "Noto Sans, Arial, sans-serif",
      "titleColor": "#111111",
      "titleFontSize": 12,
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontWeight": "bold",
      "gridColor": "#CED4DE",
      "gridDash": [
        4,
        2
      ],
      "gridWidth": 1,
      "domainColor": "#CED4DE",
      "tickColor": "#CED4DE",
      "tickCount": 5,
      "labelOverlap": "greedy"
    },
    "legend": {
      "labelColor": "#111111",
      "labelFont": "Noto Sans, Arial, sans-serif",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelLimit": 300,
      "titleColor": "#111111",
      "titleFont": "Noto Sans, Arial, sans-serif",
      "titleFontSize": 12,
      "orient": "top",
      "direction": "horizontal"
    },
    "range": {
      "category": [
        "#34A7F2",
        "#FF9800",
        "#664AB6",
        "#4EC2C0",
        "#F3578E",
        "#081079",
        "#0C7C68",
        "#AA0000",
        "#DDDA21"
      ]
    },
    "view": {
      "stroke": "transparent"
    },
    "line": {
      "strokeWidth": 3,
      "strokeCap": "round"
    },
    "point": {
      "size": 60,
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },
    "bar": {
      "cornerRadiusTopLeft": 2,
      "cornerRadiusTopRight": 2
    }
  }
}