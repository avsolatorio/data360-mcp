      "mark": {
        "type": "bar",
        "tooltip": true,
        "size": 45
      },
      "encoding": {
        "x": {
          "field": "country",
          "type": "nominal",
          "axis": {
            "title": null,
            "labelFontWeight": "bold"
          }
        },
        "y": {
