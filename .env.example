DATA360_API_BASE_URL=https://data360api.worldbank.org
# Optional base URL for static viz JSON URLs (defaults to http://localhost:MCP_PORT). Use a
# browser-reachable origin, e.g. http://127.0.0.1:8000 — see visualization.save_specs_to_static.
# WEBSITE_HOSTNAME=http://127.0.0.1:8000
MCP_PORT=8000  # use 8022 in dev
MCP_TRANSPORT=http
# POST Vega-Lite specs here instead of writing static/viz_specs/*.json.
# The vercel-ai-chatbot Charts API requires BOTH URL and a Bearer token that matches
# backend CHARTS_API_WRITE_TOKEN; omitting MCP_CHARTS_API_TOKEN causes 401 and MCP falls back to static.
MCP_CHARTS_API_URL=http://localhost:8001/api/v1/charts
MCP_CHARTS_API_TOKEN=replace-with-charts-write-token

# Choropleth (chart_type containing e.g. "choropleth", "world map", "geo map")
# MCP_CHOROPLETH_GEOJSON_URL=https://data360.worldbank.org/content/dam/sites/data/data360/api/World-including-disputed.json
# MCP_CHOROPLETH_GEO_FORMAT=json
# MCP_CHOROPLETH_GEO_FEATURE=
# TopoJSON example:
# MCP_CHOROPLETH_GEOJSON_URL=http://localhost:3000/json/wb_countries_topo.json
# MCP_CHOROPLETH_GEO_FORMAT=topojson
# MCP_CHOROPLETH_GEO_FEATURE=wb_countries
# MCP_CHOROPLETH_GEO_JOIN_KEY=ISO_A3
# Supplemental choropleth layers (defaults: same repo raw URLs as topojson; override for local dev)
# MCP_CHOROPLETH_SMALL_COUNTRIES_GEOJSON_URL=http://localhost:3000/json/small_countries_points_geo.json
# MCP_CHOROPLETH_DISPUTED_AREAS_GEOJSON_URL=http://localhost:3000/json/wb_disputed_areas_geo.json
# REF_AREA ISO3 → labels for choropleth tooltips (JSON array of {wb_a3, country_name})
# MCP_CHOROPLETH_COUNTRY_NAMES_JSON_URL=http://localhost:3000/json/ref_area_iso3_country_names.json

# Optional: set to 'local' to enable local telemetry (OTLP or console).
# MCP_ENV=local
# Run docker container: docker run --rm -d --name jaeger -p 16686:16686 -p 4317:4317 -p 4318:4318 jaegertracing/jaeger:latest
# Then set the following environment variables:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=data360-mcp
