{
  "name": "@data360/mcp-ui",
  "version": "0.1.0",
  "description": "React UI for presenting Data360 MCP tool output (Vega-Lite chart card, and future surfaces).",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./viz-card": {
      "types": "./dist/viz-card.d.ts",
      "import": "./dist/viz-card.js",
      "require": "./dist/viz-card.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vega": ">=5.0.0",
    "vega-embed": ">=6.0.0",
    "vega-lite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "keywords": [
    "data360",
    "mcp",
    "world-bank",
    "vega-lite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldbank/data360-mcp"
  }
}
